---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Headline from '../components/Headline.astro';
import Pagination from '../components/Pagination.astro';
import PostCardList from '../components/PostCardList.astro';
import Sidebar from '../components/Sidebar.astro';
import { LATEST_MAIN_PER_PAGE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getSortedPosts, paginatePosts } from '../lib/posts';

const allPosts = await getSortedPosts();
const { posts, currentPage, totalPages } = paginatePosts(allPosts, 1, LATEST_MAIN_PER_PAGE);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<div class="wrap">
			<div class="site-layout">
				<Sidebar />
				<main class="col-main">
					<Headline />

					<div class="section-bar"><span>🆕</span>最新記事</div>
					<PostCardList posts={posts} />
					<Pagination currentPage={currentPage} totalPages={totalPages} />
				</main>
			</div>
		</div>
		<Footer />
	</body>
</html>
